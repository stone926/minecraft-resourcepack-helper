      {
        "id": "custom-zip",
        "kind": "zip",
        "root": "extern-pack-b.zip",
        "priority": 1
      }
    ]
  },
  "archive": {
    "path": "extern-pack-b.zip",
    "entries": [
      {
        "path": "pack.mcmeta",
        "content": "{\"pack\":{\"pack_format\":34,\"description\":\"Lower-priority custom ZIP fixture\"}}\n"
      },
      {
        "path": "assets/external/models/block/shared_custom.json",
        "content": "{\"fixture_origin\":\"custom-zip-shadowed\",\"elements\":[]}\n"
      }
    ]
  },
