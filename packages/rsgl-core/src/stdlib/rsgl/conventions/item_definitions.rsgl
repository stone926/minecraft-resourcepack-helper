template simpleModelItem(id: ResourceId, model: ModelId) {
  item id {
    model model
  }
}

template rangeFrames(id: ResourceId, property: ResourceId, values: List<Number> | Range, model: (Number) -> ModelId | Json, fallback: ModelId) {
  item id {
    range property property {
      frames values model model(frame)
      fallback fallback
    }
  }
}

export { simpleModelItem, rangeFrames }
