target java format [50, 0]
namespace minecraft

extern! vanilla model minecraft:block/redstone_lamp
extern! vanilla model minecraft:block/redstone_lamp_on

template poweredVariants(off: ModelId, on: ModelId) {
  variants {
    [powered=false] -> @off
    [powered=true] -> @on
  }
}

blockstate abstraction/implicit_variants_body {
  use poweredVariants(
    off: minecraft:block/redstone_lamp,
    on: minecraft:block/redstone_lamp_on
  )
}
