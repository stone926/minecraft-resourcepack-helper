target java format [50, 0]
namespace minecraft

extern! vanilla texture minecraft:block/stone

model block abstraction/mirror_translate {
  texture all minecraft:block/stone
  element from [0, 0, 0] to [2, 4, 6] translate [1, 2, 3] mirror x {
    all texture "#all"
    west texture "#all" cullface west uv [0, 0, 2, 4]
  }
}
