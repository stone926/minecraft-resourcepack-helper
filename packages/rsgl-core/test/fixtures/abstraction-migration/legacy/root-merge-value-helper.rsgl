target java format [50, 0]
namespace minecraft

extern! vanilla model minecraft:block/stone

template rootMetadata(enabled: Boolean) {
  merge deep {
    custom: {
      enabled: enabled
      source: "template"
    }
  }
}

let valueMetadata: (String) -> Json = label => {
  custom: {
    label: label
  }
}

export { valueMetadata }

blockstate abstraction/root_merge_value_helper {
  use rootMetadata(true)
  merge deep valueMetadata("value-helper")
  variants {
    {} -> @minecraft:block/stone
  }
}
