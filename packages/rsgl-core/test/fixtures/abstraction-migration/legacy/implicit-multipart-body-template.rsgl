target java format [50, 0]
namespace minecraft

extern! vanilla model minecraft:block/oak_fence_post
extern! vanilla model minecraft:block/oak_fence_side

template fenceMultipart(post: ModelId, side: ModelId) {
  multipart {
    apply @post
    for direction in HORIZONTAL {
      when { [direction]: true } apply @side y=yaw(direction) uvlock=true
    }
  }
}

blockstate abstraction/implicit_multipart_body {
  use fenceMultipart(
    post: minecraft:block/oak_fence_post,
    side: minecraft:block/oak_fence_side
  )
}
