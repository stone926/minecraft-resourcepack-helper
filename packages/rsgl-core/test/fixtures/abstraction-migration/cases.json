{
  "version": 1,
  "description": "Tracked RSGL abstraction-migration cases. Legacy sources must compile with the pre-migration compiler; canonical sources are added only when their syntax is implemented.",
  "legacyProject": {
    "root": "legacy",
    "snapshot": "legacy.snapshot.json"
  },
  "resourceBodyConsumerSnapshot": "resource-body-consumers.snapshot.json",
  "templateOutputMetadataSnapshot": "template-output-metadata.snapshot.json",
  "templateOutputMetadataSnapshotKind": "resolvedSemanticMetadata",
  "templateOutputMetadataReplacementGate": "resolvedTemplateOutputMetadata is carried by semantic signatures, imports, re-exports, and compiler definitions.",
  "compatibilityRemovalGate": {
    "exactLegacyDefinitionsMustReach": 0,
    "contextualAdapterUsesMustReach": 0,
    "removeHeuristicOnlyAfterBothReachZero": true
  },
  "legacyTemplateCensus": {
    "noArrowResourceDefinitions": 10,
    "explicitPublicDefinitions": 3,
    "exactLegacyDefinitions": 2,
    "contextualAdapterDefinitions": 2,
    "exactLegacyUses": 2,
    "contextualAdapterUses": 2
  },
  "snapshotProjection": [
    "outputPath",
    "stableJson",
    "diagnostics",
    "sourceMap.generatedPath",
    "sourceMap.sourceFile",
    "sourceMap.reason",
    "sourceMap.validationOnly",
    "sourceMap.expansionFrames"
  ],
  "cases": [
    {
      "id": "full-resource-template",
      "features": ["template", "resources", "typed-template-parameters"],
      "legacy": {
        "status": "executable",
        "source": "legacy/full-resource-template.rsgl",
        "expectedDiagnostics": [],
        "expectedTemplateOutput": {
          "templateName": "fullResourceModel",
          "outputSource": "noArrowResources",
          "outputDialect": "resources",
          "expectedUseCount": 1
        }
      },
      "canonical": {
        "status": "executable",
        "source": "legacy/full-resource-template.rsgl",
        "expectedDiagnostics": [],
        "target": "No-arrow template remains the canonical full-resource form."
      }
    },
    {
      "id": "implicit-model-body-template",
      "features": ["template", "legacy-inferred-body", "model-body"],
      "legacy": {
        "status": "executable",
        "source": "legacy/implicit-model-body-template.rsgl",
        "expectedDiagnostics": [
          { "code": "rsgl.implicitTemplateOutputDialect", "severity": "warning" }
        ],
        "expectedTemplateOutput": {
          "templateName": "modelFields",
          "outputSource": "legacyContextualAdapter",
          "bodyNodeKind": "ResourceBody",
          "resolvedCallerDialect": "model",
          "expectedUseCount": 1
        }
      },
      "canonical": {
        "status": "executable",
        "source": "canonical/explicit-model-body-template.rsgl",
        "expectedDiagnostics": [],
        "target": "template ... -> model"
      }
    },
    {
      "id": "implicit-variants-body-template",
      "features": ["template", "legacy-inferred-body", "blockstate-variants"],
      "legacy": {
        "status": "executable",
        "source": "legacy/implicit-variants-body-template.rsgl",
        "expectedDiagnostics": [
          { "code": "rsgl.blockstateModeRequired", "severity": "warning" },
          { "code": "rsgl.implicitTemplateOutputDialect", "severity": "warning" },
          { "code": "rsgl.legacyBlockstateEntryArrow", "severity": "warning" },
          { "code": "rsgl.legacyBlockstateEntryArrow", "severity": "warning" },
          { "code": "rsgl.legacyBlockstateWrapper", "severity": "warning" },
          { "code": "rsgl.legacyModelApplySugar", "severity": "warning" },
          { "code": "rsgl.legacyModelApplySugar", "severity": "warning" },
          { "code": "rsgl.legacyStateKeySugar", "severity": "warning" },
          { "code": "rsgl.legacyStateKeySugar", "severity": "warning" }
        ],
        "expectedTemplateOutput": {
          "templateName": "poweredVariants",
          "outputSource": "legacyInferredBody",
          "bodyKind": "blockstateRoot",
          "mode": "variants",
          "allowRootMerge": true,
          "allowBase": false,
          "expectedUseCount": 1
        }
      },
      "canonical": {
        "status": "executable",
        "source": "canonical/explicit-variants-body-template.rsgl",
        "expectedDiagnostics": [],
        "target": "template ... -> variants used by blockstate variants <id>",
        "expectedRangeCategories": ["selector", "model", "templateArgument"]
      }
    },
