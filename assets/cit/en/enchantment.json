      "appliesTo": ["enchantment"],
      "default": "add",
      "singleton": true,
      "title": "Blend",
      "description": "Sets a named or custom OpenGL blend function for the glint texture."
    },
    "useGlint": {
      "valueType": "boolean",
      "scope": ["cit"],
      "appliesTo": ["enchantment"],
      "default": "false",
      "singleton": true,
      "citResewnOnly": true,
      "title": "Use default glint",
      "description": "Controls whether the default enchantment glint is shown on the item."
    },
    "blur": {
      "valueType": "boolean",
      "scope": ["cit"],
      "appliesTo": ["enchantment"],
      "default": "false",
      "singleton": true,
      "citResewnOnly": true,
      "title": "Blur",
      "description": "Controls whether the texture is blurred before being applied."
