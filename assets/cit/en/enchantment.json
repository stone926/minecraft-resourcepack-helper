{
  "version": 1,
  "id": "enchantment",
  "scope": "cit",
  "keys": {
    "texture": {
      "valueType": "asset",
      "assetKind": "texture",
      "scope": ["cit"],
      "appliesTo": ["enchantment"],
      "singleton": true,
      "title": "Glint texture",
      "description": "Replaces this enchantment glint layer with the resolved texture."
    },
    "layer": {
      "valueType": "integer",
      "scope": ["cit"],
      "appliesTo": ["enchantment"],
      "default": "0",
      "singleton": true,
      "minimum": 0,
      "title": "Layer",
      "description": "Controls this glint layer's render order."
    },
    "speed": {
      "valueType": "number",
      "scope": ["cit"],
      "appliesTo": ["enchantment"],
      "default": "0.0",
      "singleton": true,
      "title": "Speed",
      "description": "Multiplies the glint scroll speed."
    },
    "rotation": {
      "valueType": "number",
      "scope": ["cit"],
      "appliesTo": ["enchantment"],
      "default": "0.0",
      "singleton": true,
      "title": "Rotation",
      "description": "Rotates the glint texture and scroll direction in degrees."
    },
    "duration": {
      "valueType": "nonNegativeNumber",
      "scope": ["cit"],
      "appliesTo": ["enchantment"],
      "default": "0.0",
      "singleton": true,
      "title": "Duration",
      "description": "Controls how long this glint pauses when global method is cycle."
    },
    "blend": {
      "valueType": "blendFunc",
      "enum": ["replace", "glint", "alpha", "add", "subtract", "multiply", "dodge", "burn", "screen", "overlay"],
