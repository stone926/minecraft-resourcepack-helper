      "default": "1.0",
      "singleton": true,
      "citResewnOnly": true,
      "title": "Blue multiplier",
      "description": "Multiplies the texture's blue channel."
    },
    "a": {
      "valueType": "positiveNumber",
      "scope": ["cit"],
      "appliesTo": ["enchantment"],
      "default": "1.0",
      "singleton": true,
