{
  "version": 1,
  "id": "base",
  "scope": "cit",
  "keys": {
    "type": {
      "valueType": "enum",
      "enum": ["item", "armor", "elytra", "enchantment"],
      "scope": ["cit"],
      "appliesTo": ["base"],
      "default": "item",
      "singleton": true,
      "title": "CIT 类型",
      "description": "选择此 properties 文件描述的 CIT 效果类型。"
    },
    "weight": {
      "valueType": "integer",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "aliases": ["cit_weight", "citWeight"],
      "default": "0",
      "singleton": true,
      "title": "权重",
      "description": "当多个 CIT 匹配同一物品时，决定优先使用哪一个。"
    },
    "cit_fallback": {
      "valueType": "string",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "aliases": ["citFallback"],
      "singleton": true,
      "title": "后备 CIT",
      "description": "指定此 CIT 成功加载后应移除的 legacy root CIT。"
    },
    "items": {
      "valueType": "resourceList",
      "resourceKind": "item",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "aliases": ["matchItems"],
      "separator": "space",
      "singleton": true,
      "title": "物品",
      "description": "要求物品匹配列出的任一物品 ID。"
    },
    "stackSize": {
      "valueType": "range",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "aliases": ["stack_size", "amount"],
      "singleton": true,
      "minimum": 1,
      "title": "堆叠数量",
      "description": "要求物品堆叠数量匹配整数或整数范围。"
    },
    "damage": {
      "valueType": "range",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "aliases": ["damage_mask"],
      "singleton": true,
      "minimum": 0,
      "allowPercent": true,
      "title": "耐久损伤",
      "description": "要求物品耐久损伤匹配整数、范围、百分比或百分比范围。"
    },
    "damageMask": {
      "valueType": "integer",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "singleton": true,
      "minimum": 0,
      "title": "耐久掩码",
      "description": "在匹配 damage 前对物品耐久应用二进制掩码。"
    },
    "hand": {
      "valueType": "enum",
      "enum": ["main", "mainhand", "main_hand", "off", "offhand", "off_hand", "any", "either", "*"],
      "scope": ["cit"],
      "appliesTo": ["base"],
      "singleton": true,
      "title": "手持位置",
      "description": "要求物品位于主手或副手。"
    },
    "enchantments": {
      "valueType": "resourceList",
      "resourceKind": "enchantment",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "aliases": ["enchantmentIDs"],
      "separator": "space",
      "singleton": true,
      "title": "附魔",
      "description": "要求物品拥有列出的任一附魔 ID。"
    },
    "enchantmentLevels": {
      "valueType": "rangeList",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "aliases": ["enchantment_levels"],
      "separator": "space",
      "singleton": true,
      "minimum": 1,
      "title": "附魔等级",
      "description": "要求附魔等级匹配列出的某个等级或范围。"
    }
  },
  "patterns": {
    "nbt.*": {
      "valueType": "nbtMatch",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "repeatable": true,
      "runtimeStatus": "legacy",
      "runtimeNote": "Minecraft 1.21+ 已将物品数据从 NBT 迁移到数据组件；新 CIT 规则优先使用 component.* 或 components.*。",
      "title": "NBT 匹配",
      "description": "legacy 规则：按指定 NBT 路径匹配字面值、通配模式或正则表达式。"
    },
    "component.*": {
      "valueType": "nbtMatch",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "repeatable": true,
      "completion": "component.",
      "title": "组件匹配",
      "description": "按指定的 1.21+ 物品数据组件路径匹配字面值、通配模式或正则表达式。"
    },
    "components.*": {
      "valueType": "nbtMatch",
      "scope": ["cit"],
      "appliesTo": ["base"],
      "repeatable": true,
      "completion": "components.",
      "title": "组件匹配",
      "description": "component.* 的别名，用于匹配 1.21+ 物品数据组件路径。"
    }
  }
}
