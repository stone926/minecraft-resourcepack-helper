{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Minecraft 物品模型定义",
  "description": "新版 items 目录中的物品模型选择定义。",
  "additionalProperties": true,
  "required": ["model"],
  "properties": {
    "model": {
      "$ref": "#/definitions/itemModel",
      "title": "model 物品模型"
    },
    "hand_animation_on_swap": {
      "type": "boolean",
      "title": "hand_animation_on_swap 切换动画",
      "description": "切换物品栏槽位或交换到另一只手时是否播放第一人称下压动画，默认为 true。"
    },
    "oversized_in_gui": {
      "type": "boolean",
      "title": "oversized_in_gui GUI 超尺寸渲染",
      "description": "物品模型是否允许在 GUI 中渲染到物品槽外，默认为 false。"
    },
    "swap_animation_scale": {
      "type": "number",
      "title": "swap_animation_scale 切换动画缩放"
    }
  },
  "definitions": {
    "resourceLocation": {
      "type": "string",
      "description": "Minecraft 资源路径，例如 minecraft:item/diamond_sword。"
    },
    "topLevelType": {
      "type": "string",
      "enum": [
        "minecraft:model",
        "minecraft:composite",
        "minecraft:condition",
        "minecraft:select",
        "minecraft:range_dispatch",
        "minecraft:empty",
        "minecraft:bundle/selected_item",
        "minecraft:special",
        "model",
        "composite",
        "condition",
        "select",
        "range_dispatch",
        "empty",
        "bundle/selected_item",
        "special"
      ]
    },
    "itemModel": {
      "oneOf": [
        { "$ref": "#/definitions/modelItemModel" },
        { "$ref": "#/definitions/compositeItemModel" },
        { "$ref": "#/definitions/conditionItemModel" },
        { "$ref": "#/definitions/selectItemModel" },
        { "$ref": "#/definitions/rangeDispatchItemModel" },
        { "$ref": "#/definitions/specialItemModel" },
        { "$ref": "#/definitions/selectedItemModel" },
        { "$ref": "#/definitions/emptyItemModel" }
      ]
    },
    "transformableItemModel": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "transformation": {
          "$ref": "#/definitions/transformation",
          "title": "transformation 显示变换",
          "description": "物品模型显示变换，可为 4x4 矩阵或拆分的平移、缩放、旋转对象。"
        }
      }
    },
    "modelItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "model"],
          "properties": {
            "type": {
              "type": "string",
              "title": "type 普通模型",
              "enum": ["minecraft:model", "model"]
            },
            "model": {
              "$ref": "#/definitions/resourceLocation",
              "title": "model 模型"
            },
            "tints": {
              "type": "array",
              "title": "tints 着色",
              "items": {
                "$ref": "#/definitions/tint"
              }
            }
          }
        }
      ]
    },
    "compositeItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "models"],
          "properties": {
            "type": {
              "type": "string",
              "title": "type 组合模型",
              "enum": ["minecraft:composite", "composite"]
            },
            "models": {
              "type": "array",
              "title": "models 组合模型",
              "items": {
                "$ref": "#/definitions/itemModel"
              }
            }
          }
        }
      ]
    },
    "conditionItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "property", "on_true", "on_false"],
          "allOf": [
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:component", "component"] }
                }
              },
              "then": { "required": ["predicate", "value"] }
            },
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:has_component", "has_component"] }
                }
              },
              "then": { "required": ["component"] }
            },
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:keybind_down", "keybind_down"] }
                }
              },
              "then": { "required": ["keybind"] }
            }
          ],
          "properties": {
            "type": {
              "type": "string",
              "title": "type 条件模型",
              "enum": ["minecraft:condition", "condition"]
            },
            "property": {
              "$ref": "#/definitions/conditionPropertyType",
              "title": "property 布尔属性"
            },
            "component": {
              "type": "string",
              "title": "component 组件"
            },
            "ignore_default": {
              "type": "boolean",
              "title": "ignore_default 忽略默认组件"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "title": "index 索引"
            },
            "keybind": {
              "type": "string",
              "title": "keybind 按键绑定"
            },
            "predicate": {
              "type": "string",
              "title": "predicate 谓词",
              "description": "数据组件谓词类型（用于 minecraft:component 属性）。"
            },
            "value": {
              "title": "value 比较值",
              "description": "与谓词匹配的值（用于 minecraft:component 属性）。"
            },
            "on_true": {
              "$ref": "#/definitions/itemModel",
              "title": "on_true 条件为真"
            },
            "on_false": {
              "$ref": "#/definitions/itemModel",
              "title": "on_false 条件为假"
            }
          }
        }
      ]
    },
    "selectItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "property", "cases"],
          "allOf": [
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:block_state", "block_state"] }
                }
              },
              "then": { "required": ["block_state_property"] }
            },
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:component", "component"] }
                }
              },
              "then": { "required": ["component"] }
            },
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:local_time", "local_time"] }
                }
              },
              "then": { "required": ["pattern"] }
            }
          ],
          "properties": {
            "type": {
              "type": "string",
              "title": "type 枚举选择模型",
              "enum": ["minecraft:select", "select"]
            },
            "property": {
              "$ref": "#/definitions/selectPropertyType",
              "title": "property 枚举属性"
            },
            "component": {
              "type": "string",
              "title": "component 组件"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "title": "index 索引"
            },
            "block_state_property": {
              "type": "string",
              "title": "block_state_property 方块状态属性"
            },
            "locale": {
              "type": "string",
              "title": "locale 本地化"
            },
            "time_zone": {
              "type": "string",
              "title": "time_zone 时区"
            },
            "pattern": {
              "type": "string",
              "title": "pattern 格式"
            },
            "cases": {
              "type": "array",
              "title": "cases 条件分支",
              "items": {
                "$ref": "#/definitions/selectCase"
              }
            },
            "fallback": {
              "$ref": "#/definitions/itemModel",
              "title": "fallback 后备模型"
            }
          }
        }
      ]
    },
    "rangeDispatchItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "property", "entries"],
          "allOf": [
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:compass", "compass"] }
                }
              },
              "then": { "required": ["target"] }
            },
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:time", "time"] }
                }
              },
              "then": { "required": ["source"] }
            }
          ],
          "properties": {
            "type": {
              "type": "string",
              "title": "type 数值分发模型",
              "enum": ["minecraft:range_dispatch", "range_dispatch"]
            },
            "property": {
              "$ref": "#/definitions/rangeDispatchPropertyType",
              "title": "property 数值属性"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "title": "index 索引"
            },
            "normalize": {
              "type": "boolean",
              "title": "normalize 归一化"
            },
            "wobble": {
              "type": "boolean",
              "title": "wobble 摆动"
            },
            "remaining": {
              "type": "boolean",
              "title": "remaining 剩余时长"
            },
            "period": {
              "type": "number",
              "exclusiveMinimum": 0,
              "title": "period 周期"
            },
            "target": {
              "type": "string",
              "title": "target 指南针目标",
              "enum": ["spawn", "lodestone", "recovery", "none"]
            },
            "source": {
              "type": "string",
              "title": "source 来源",
              "enum": ["daytime", "moon_phase", "random"]
            },
            "entries": {
              "type": "array",
              "title": "entries 阈值分发",
              "items": {
                "$ref": "#/definitions/rangeEntry"
              }
            },
            "fallback": {
              "$ref": "#/definitions/itemModel",
              "title": "fallback 后备模型"
            },
            "scale": {
              "type": "number",
              "title": "scale 数值缩放",
              "description": "range_dispatch 属性值缩放。"
            }
          }
        }
      ]
    },
    "specialItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "base", "model"],
          "properties": {
            "type": {
              "type": "string",
              "title": "type 特殊模型",
              "enum": ["minecraft:special", "special"]
            },
            "base": {
              "$ref": "#/definitions/resourceLocation",
              "title": "base 基础模型",
              "description": "特殊模型使用的基础物品模型，解析到 assets/<namespace>/models/<path>.json。"
            },
            "model": {
              "$ref": "#/definitions/specialModel",
              "title": "model 特殊模型配置"
            }
          }
        }
      ]
    },
    "selectedItemModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 选中物品",
          "enum": ["minecraft:bundle/selected_item", "bundle/selected_item"]
        }
      }
    },
    "emptyItemModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 空模型",
          "enum": ["minecraft:empty", "empty"]
        }
      }
    },
    "conditionPropertyType": {
      "type": "string",
      "enum": [
        "minecraft:broken",
        "minecraft:bundle/has_selected_item",
        "minecraft:carried",
        "minecraft:component",
        "minecraft:custom_model_data",
        "minecraft:damaged",
        "minecraft:extended_view",
        "minecraft:fishing_rod/cast",
        "minecraft:has_component",
        "minecraft:keybind_down",
        "minecraft:selected",
        "minecraft:using_item",
        "minecraft:view_entity",
        "broken",
        "bundle/has_selected_item",
        "carried",
        "component",
        "custom_model_data",
        "damaged",
        "extended_view",
        "fishing_rod/cast",
        "has_component",
        "keybind_down",
        "selected",
        "using_item",
        "view_entity"
      ]
    },
    "selectPropertyType": {
      "type": "string",
      "enum": [
        "minecraft:block_state",
        "minecraft:charge_type",
        "minecraft:component",
        "minecraft:context_dimension",
        "minecraft:context_entity_type",
        "minecraft:custom_model_data",
        "minecraft:display_context",
        "minecraft:local_time",
        "minecraft:main_hand",
        "minecraft:trim_material",
        "block_state",
        "charge_type",
        "component",
        "context_dimension",
        "context_entity_type",
        "custom_model_data",
        "display_context",
        "local_time",
        "main_hand",
        "trim_material"
      ]
    },
    "rangeDispatchPropertyType": {
      "type": "string",
      "enum": [
        "minecraft:bundle/fullness",
        "minecraft:compass",
        "minecraft:cooldown",
        "minecraft:count",
        "minecraft:crossbow/pull",
        "minecraft:custom_model_data",
        "minecraft:damage",
        "minecraft:time",
        "minecraft:use_cycle",
        "minecraft:use_duration",
        "bundle/fullness",
        "compass",
        "cooldown",
        "count",
        "crossbow/pull",
        "custom_model_data",
        "damage",
        "time",
        "use_cycle",
        "use_duration"
      ]
    },
    "rangeEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["threshold", "model"],
      "properties": {
        "threshold": {
          "type": "number",
          "title": "threshold 阈值"
        },
        "model": {
          "$ref": "#/definitions/itemModel",
          "title": "model 模型"
        }
      }
    },
    "selectCase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["when", "model"],
      "properties": {
        "when": {
          "title": "when 匹配值"
        },
        "model": {
          "$ref": "#/definitions/itemModel",
          "title": "model 模型"
        }
      }
    },
    "tint": {
      "oneOf": [
        { "$ref": "#/definitions/constantTint" },
        { "$ref": "#/definitions/dyeTint" },
        { "$ref": "#/definitions/fireworkTint" },
        { "$ref": "#/definitions/grassTint" },
        { "$ref": "#/definitions/mapColorTint" },
        { "$ref": "#/definitions/potionTint" },
        { "$ref": "#/definitions/teamTint" },
        { "$ref": "#/definitions/customModelDataTint" }
      ]
    },
    "constantTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 着色类型",
          "enum": ["minecraft:constant", "constant"]
        },
        "value": {
          "$ref": "#/definitions/colorValue",
          "title": "value 固定颜色"
        }
      }
    },
    "dyeTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 着色类型",
          "enum": ["minecraft:dye", "dye"]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "default 默认颜色"
        }
      }
    },
    "fireworkTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 着色类型",
          "enum": ["minecraft:firework", "firework"]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "default 默认颜色"
        }
      }
    },
    "grassTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "temperature", "downfall"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 着色类型",
          "enum": ["minecraft:grass", "grass"]
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "temperature 温度"
        },
        "downfall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "downfall 降水"
        }
      }
    },
    "mapColorTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 着色类型",
          "enum": ["minecraft:map_color", "map_color"]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "default 默认颜色"
        }
      }
    },
    "potionTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 着色类型",
          "enum": ["minecraft:potion", "potion"]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "default 默认颜色"
        }
      }
    },
    "teamTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 着色类型",
          "enum": ["minecraft:team", "team"]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "default 默认颜色"
        }
      }
    },
    "customModelDataTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 着色类型",
          "enum": ["minecraft:custom_model_data", "custom_model_data"]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "title": "index 索引"
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "default 默认颜色"
        }
      }
    },
    "specialModel": {
      "oneOf": [
        { "$ref": "#/definitions/bannerSpecialModel" },
        { "$ref": "#/definitions/bellSpecialModel" },
        { "$ref": "#/definitions/bookSpecialModel" },
        { "$ref": "#/definitions/chestSpecialModel" },
        { "$ref": "#/definitions/conduitSpecialModel" },
        { "$ref": "#/definitions/copperGolemStatueSpecialModel" },
        { "$ref": "#/definitions/decoratedPotSpecialModel" },
        { "$ref": "#/definitions/endCubeSpecialModel" },
        { "$ref": "#/definitions/headSpecialModel" },
        { "$ref": "#/definitions/playerHeadSpecialModel" },
        { "$ref": "#/definitions/shieldSpecialModel" },
        { "$ref": "#/definitions/shulkerBoxSpecialModel" },
        { "$ref": "#/definitions/tridentSpecialModel" }
      ]
    },
    "specialModelType": {
      "type": "string",
      "enum": [
        "minecraft:banner",
        "minecraft:bell",
        "minecraft:book",
        "minecraft:chest",
        "minecraft:conduit",
        "minecraft:copper_golem_statue",
        "minecraft:decorated_pot",
        "minecraft:end_cube",
        "minecraft:head",
        "minecraft:player_head",
        "minecraft:shield",
        "minecraft:shulker_box",
        "minecraft:trident",
        "banner",
        "bell",
        "book",
        "chest",
        "conduit",
        "copper_golem_statue",
        "decorated_pot",
        "end_cube",
        "head",
        "player_head",
        "shield",
        "shulker_box",
        "trident"
      ]
    },
    "bannerSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "color"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:banner", "banner"]
        },
        "attachment": {
          "type": "string",
          "title": "attachment 附着方式",
          "enum": ["ground", "wall"]
        },
        "color": {
          "$ref": "#/definitions/dyeColor",
          "title": "color 颜色"
        }
      }
    },
    "bellSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:bell", "bell"]
        }
      }
    },
    "bookSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "open_angle", "page1", "page2"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:book", "book"]
        },
        "open_angle": {
          "type": "integer",
          "title": "open_angle 书本打开角度"
        },
        "page1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "page1 第一页位置"
        },
        "page2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "page2 第二页位置"
        }
      }
    },
    "chestSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "texture"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:chest", "chest"]
        },
        "texture": {
          "$ref": "#/definitions/resourceLocation",
          "title": "texture 箱子纹理",
          "description": "解析到 textures/entity/chest/<path>.png。"
        },
        "chest_type": {
          "type": "string",
          "title": "chest_type 箱子类型",
          "enum": ["single", "left", "right"]
        },
        "openness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "openness 开启程度"
        }
      }
    },
    "conduitSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:conduit", "conduit"]
        }
      }
    },
    "copperGolemStatueSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "pose", "texture"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:copper_golem_statue", "copper_golem_statue"]
        },
        "pose": {
          "type": "string",
          "title": "pose 姿势",
          "enum": ["standing", "sitting", "running", "star"]
        },
        "texture": {
          "$ref": "#/definitions/resourceLocation",
