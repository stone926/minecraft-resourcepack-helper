{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Minecraft 图集定义",
  "description": "定义纹理图集的来源列表。资源路径相对于 assets/<namespace>/textures。",
  "additionalProperties": true,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "title": "sources 图集来源",
      "description": "按顺序列出加入图集的纹理来源。",
      "items": {
        "$ref": "#/definitions/source"
      }
    }
  },
  "definitions": {
    "resourceLocation": {
      "type": "string",
      "description": "Minecraft 资源路径，例如 minecraft:block/stone；省略命名空间时默认为 minecraft。"
    },
    "source": {
      "oneOf": [
        { "$ref": "#/definitions/directorySource" },
        { "$ref": "#/definitions/singleSource" },
        { "$ref": "#/definitions/filterSource" },
        { "$ref": "#/definitions/unstitchSource" },
        { "$ref": "#/definitions/palettedPermutationsSource" }
      ]
    },
    "sourceBase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "title": "type 来源类型",
          "description": "图集来源类型。",
          "enum": [
            "directory",
            "single",
            "paletted_permutations",
            "filter",
            "unstitch",
            "minecraft:directory",
            "minecraft:single",
            "minecraft:paletted_permutations",
            "minecraft:filter",
            "minecraft:unstitch"
          ]
        },
        "source": {
          "$ref": "#/definitions/resourceLocation",
          "title": "source 来源目录",
          "description": "directory 来源读取的纹理目录。"
        },
        "prefix": {
          "type": "string",
          "title": "prefix 前缀",
          "description": "directory 来源添加到图集后的资源路径前缀。"
        },
        "pattern": {
          "type": "object",
          "title": "pattern 过滤模式",
          "description": "filter 来源移除已加入图集的 sprite 时使用的命名空间和路径正则。",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "format": "regex"
            },
            "path": {
              "type": "string",
              "format": "regex"
            }
          }
        },
        "resource": {
          "$ref": "#/definitions/resourceLocation",
          "title": "resource 单个纹理",
          "description": "single 或 unstitch 来源读取的纹理。"
        },
        "sprite": {
          "$ref": "#/definitions/resourceLocation",
          "title": "sprite 图集名",
          "description": "single 来源写入图集时使用的 sprite 名称。"
        },
        "divisor_x": {
          "type": "number",
          "title": "divisor_x 横向单位",
          "description": "unstitch 来源中用于换算区域 x 坐标的单位。"
        },
        "divisor_y": {
          "type": "number",
          "title": "divisor_y 纵向单位",
          "description": "unstitch 来源中用于换算区域 y 坐标的单位。"
        },
        "regions": {
          "type": "array",
          "title": "regions 切片区域",
          "description": "unstitch 来源从原图中复制出的矩形区域。",
          "items": {
            "$ref": "#/definitions/unstitchRegion"
          }
        },
        "palette_key": {
          "$ref": "#/definitions/resourceLocation",
          "title": "palette_key 调色板键",
          "description": "paletted_permutations 使用的调色板基准纹理。"
        },
        "separator": {
          "type": "string",
          "title": "separator 分隔符",
          "description": "paletted_permutations 生成 sprite 名称时连接基础纹理和变体名称的分隔符，默认为 _。"
        },
        "permutations": {
          "type": "object",
          "title": "permutations 调色板变体",
          "description": "调色板名称到纹理路径的映射。",
          "additionalProperties": {
            "$ref": "#/definitions/resourceLocation"
          }
        },
        "textures": {
          "type": "array",
          "title": "textures 纹理",
          "description": "paletted_permutations 应用到的一组纹理。",
          "items": {
            "$ref": "#/definitions/resourceLocation"
          }
        }
      }
    },
    "directorySource": {
      "allOf": [
        { "$ref": "#/definitions/sourceBase" },
        {
          "type": "object",
          "required": ["type", "source", "prefix"],
          "properties": {
            "type": {
              "enum": ["directory", "minecraft:directory"]
            }
          }
        }
      ]
    },
    "singleSource": {
      "allOf": [
        { "$ref": "#/definitions/sourceBase" },
        {
          "type": "object",
          "required": ["type", "resource"],
          "properties": {
            "type": {
              "enum": ["single", "minecraft:single"]
            }
          }
        }
      ]
    },
    "filterSource": {
      "allOf": [
        { "$ref": "#/definitions/sourceBase" },
        {
          "type": "object",
          "required": ["type", "pattern"],
          "properties": {
            "type": {
              "enum": ["filter", "minecraft:filter"]
            }
          }
        }
      ]
    },
    "unstitchSource": {
      "allOf": [
        { "$ref": "#/definitions/sourceBase" },
        {
          "type": "object",
          "required": ["type", "resource", "regions"],
          "properties": {
            "type": {
              "enum": ["unstitch", "minecraft:unstitch"]
            }
          }
        }
      ]
    },
    "palettedPermutationsSource": {
      "allOf": [
        { "$ref": "#/definitions/sourceBase" },
        {
          "type": "object",
          "required": ["type", "textures", "palette_key", "permutations"],
          "properties": {
            "type": {
              "enum": ["paletted_permutations", "minecraft:paletted_permutations"]
            }
          }
        }
      ]
    },
    "unstitchRegion": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sprite", "x", "y", "width", "height"],
      "properties": {
        "sprite": {
          "$ref": "#/definitions/resourceLocation",
          "title": "sprite 图集名"
        },
        "x": {
          "type": "number",
          "title": "x 横坐标"
        },
        "y": {
          "type": "number",
          "title": "y 纵坐标"
        },
        "width": {
          "type": "number",
          "title": "width 宽度"
        },
        "height": {
          "type": "number",
          "title": "height 高度"
        }
      }
    }
  }
}
