{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "array",
  "title": "Minecraft 鸣谢名单",
  "description": "定义 Minecraft 制作人员名单的章节、部门、职位和姓名。",
  "items": {
    "$ref": "#/definitions/section"
  },
  "definitions": {
    "section": {
      "type": "object",
      "additionalProperties": true,
      "required": ["section", "disciplines"],
      "properties": {
        "section": {
          "type": "string",
          "title": "section 章节"
        },
        "disciplines": {
          "type": "array",
          "title": "disciplines 部门",
          "items": {
            "$ref": "#/definitions/discipline"
          }
        }
      }
    },
    "discipline": {
      "type": "object",
      "additionalProperties": true,
      "required": ["discipline", "titles"],
      "properties": {
        "discipline": {
          "type": "string",
          "title": "discipline 部门名称"
        },
        "titles": {
          "type": "array",
          "title": "titles 职位",
          "items": {
            "$ref": "#/definitions/title"
          }
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "names"],
      "properties": {
        "title": {
          "type": "string",
          "title": "title 职位名称"
        },
        "names": {
          "type": "array",
          "title": "names 人员姓名",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
