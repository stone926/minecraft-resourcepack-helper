{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Minecraft 后处理效果定义",
  "description": "定义后处理渲染目标和 pass 列表。",
  "additionalProperties": true,
  "properties": {
    "targets": {
      "type": "object",
      "title": "targets 渲染目标",
      "additionalProperties": {
        "$ref": "#/definitions/target"
      }
    },
    "passes": {
      "type": "array",
      "title": "passes 后处理步骤",
      "items": {
        "$ref": "#/definitions/pass"
      }
    }
  },
  "definitions": {
    "target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "title": "width 宽度"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "title": "height 高度"
        },
        "persistent": {
          "type": "boolean",
          "title": "persistent 持久化",
          "description": "为 true 时此渲染目标不会在每帧之间清除，默认 false。"
        },
        "clear_color": {
          "title": "clear_color 清除颜色",
          "description": "渲染目标创建或清除时使用的颜色，可为 ARGB 十进制颜色或 [R, G, B, A] 浮点数组。",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          ]
        }
      }
    },
    "pass": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "vertex_shader": {
          "type": "string",
          "title": "vertex_shader 顶点着色器",
          "description": "顶点着色器资源路径。插件会解析到 shaders 下的 .vsh 文件。"
        },
        "fragment_shader": {
          "type": "string",
          "title": "fragment_shader 片段着色器",
          "description": "片段着色器资源路径。插件会解析到 shaders 下的 .fsh 文件。"
        },
        "inputs": {
          "type": "array",
          "title": "inputs 输入",
          "items": {
            "$ref": "#/definitions/input"
          }
        },
        "output": {
          "type": "string",
          "title": "output 输出目标",
          "description": "此 pass 的输出目标。只能是 minecraft:main 或 targets 中定义的自定义目标；其他内置目标仅可作为只读输入。"
        },
        "uniforms": {
          "type": "object",
          "title": "uniforms uniform 配置",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/uniform"
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sampler_name": {
          "type": "string",
          "title": "sampler_name 采样器名称"
        },
        "target": {
          "type": "string",
          "title": "target 输入目标",
          "description": "输入目标名称，可引用 targets 中定义的自定义目标，或七个只读内置输入目标：minecraft:main、minecraft:translucent、minecraft:item_entity、minecraft:particles、minecraft:weather、minecraft:clouds、minecraft:entity_outline。"
        },
        "use_depth_buffer": {
          "type": "boolean",
          "title": "use_depth_buffer 使用深度缓冲",
          "description": "为 true 时从目标的深度纹理采样，默认 false。"
        },
        "location": {
          "type": "string",
          "title": "location 输入纹理",
          "description": "输入纹理资源路径。插件会解析到 textures/effect。"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "title": "width 纹理宽度"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "title": "height 纹理高度"
        },
        "bilinear": {
          "type": "boolean",
          "title": "bilinear 双线性过滤"
        }
      }
    },
    "uniform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "title": "name 名称"
        },
        "type": {
          "type": "string",
          "title": "type 类型",
          "enum": ["float", "int", "ivec3", "vec2", "vec3", "vec4", "matrix4x4"]
        },
        "value": {
          "title": "value 值",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          ]
        }
      }
    }
  }
}
