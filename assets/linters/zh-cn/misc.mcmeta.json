{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Minecraft 纹理采样元数据",
  "description": "定义 PNG 纹理的采样属性。",
  "additionalProperties": false,
  "required": ["texture"],
  "properties": {
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "description": "包含了纹理的数据",
      "properties": {
        "blur": { "type": "boolean", "description": "指定从近距离观察时是否导致纹理模糊。默认为false" },
        "clamp": { "type": "boolean", "description": "指定是否在原来的情况下以伸展纹理代替平铺纹理。默认为false" },
        "mipmaps": { "type": "integer", "description": "纹理的自定义mipmap值" }
      }
    }
  }
}
