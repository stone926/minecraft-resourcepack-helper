{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "Minecraft 语言文件",
  "description": "定义本地化键与显示文本的映射，或语言键替换/移除规则。",
  "anyOf": [
    {
      "$ref": "#/definitions/translations"
    },
    {
      "$ref": "#/definitions/deprecated"
    }
  ],
  "definitions": {
    "translations": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "description": "本地化键对应的文本。"
      }
    },
    "deprecated": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "title": "removed 移除的键",
          "items": {
            "type": "string"
          }
        },
        "renamed": {
          "type": "object",
          "title": "renamed 重命名的键",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
