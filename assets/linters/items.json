{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/stone926/minecraft-resourcepack-helper/schemas/items.json",
  "type": "object",
  "title": "Minecraft item model definition",
  "description": "新版 items 目录中的物品模型选择定义。",
  "additionalProperties": true,
  "required": ["model"],
  "properties": {
    "model": {
      "$ref": "#/definitions/itemModel",
      "title": "model 物品模型"
    },
    "hand_animation_on_swap": {
      "type": "boolean",
      "title": "hand_animation_on_swap 切换动画",
      "description": "切换物品栏槽位或交换到另一只手时是否播放第一人称下压动画，默认为 true。"
    },
    "oversized_in_gui": {
      "type": "boolean",
      "title": "oversized_in_gui GUI 超尺寸渲染",
      "description": "物品模型是否允许在 GUI 中渲染到物品槽外，默认为 false。"
    },
    "swap_animation_scale": {
      "type": "number",
      "title": "swap_animation_scale 切换动画缩放"
    }
  },
  "definitions": {
    "resourceLocation": {
      "type": "string",
      "description": "Minecraft 资源路径，例如 minecraft:item/diamond_sword。"
    },
    "itemModel": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "title": "type 模型类型",
          "enum": [
            "minecraft:model",
            "minecraft:composite",
            "minecraft:condition",
            "minecraft:select",
            "minecraft:range_dispatch",
            "minecraft:special",
            "minecraft:bundle/selected_item",
            "minecraft:empty",
            "minecraft:banner",
            "minecraft:bed",
            "minecraft:bell",
            "minecraft:book",
            "minecraft:chest",
            "minecraft:conduit",
            "minecraft:copper_golem_statue",
            "minecraft:decorated_pot",
            "minecraft:end_cube",
            "minecraft:head",
            "minecraft:player_head",
            "minecraft:shield",
            "minecraft:shulker_box",
            "minecraft:standing_sign",
            "minecraft:hanging_sign",
            "minecraft:trident"
          ]
        },
        "model": {
          "title": "model 模型",
          "description": "minecraft:model 中为模型资源路径；在分发器条目中也可为嵌套 item model。",
          "oneOf": [
            {
              "$ref": "#/definitions/resourceLocation"
            },
            {
              "$ref": "#/definitions/itemModel"
            }
          ]
        },
        "models": {
          "type": "array",
          "title": "models 组合模型",
          "items": {
            "$ref": "#/definitions/itemModel"
          }
        },
        "on_true": {
          "$ref": "#/definitions/itemModel",
          "title": "on_true 条件为真"
        },
        "on_false": {
          "$ref": "#/definitions/itemModel",
          "title": "on_false 条件为假"
        },
        "fallback": {
          "$ref": "#/definitions/itemModel",
          "title": "fallback 后备模型"
        },
        "base": {
          "title": "base 基础模型",
          "oneOf": [
            {
              "$ref": "#/definitions/resourceLocation"
            },
            {
              "$ref": "#/definitions/itemModel"
            }
          ]
        },
        "property": {
          "type": "string",
          "title": "property 属性",
          "enum": [
            "minecraft:block_state",
            "minecraft:broken",
            "minecraft:bundle/fullness",
            "minecraft:bundle/has_selected_item",
            "minecraft:carried",
            "minecraft:charge_type",
            "minecraft:component",
            "minecraft:compass",
            "minecraft:context_dimension",
            "minecraft:context_entity_type",
            "minecraft:cooldown",
            "minecraft:count",
            "minecraft:crossbow/pull",
            "minecraft:custom_model_data",
            "minecraft:damage",
            "minecraft:damaged",
            "minecraft:display_context",
            "minecraft:extended_view",
            "minecraft:fishing_rod/cast",
            "minecraft:has_component",
            "minecraft:keybind_down",
            "minecraft:local_time",
            "minecraft:main_hand",
            "minecraft:selected",
            "minecraft:time",
            "minecraft:trim_material",
            "minecraft:use_cycle",
            "minecraft:use_duration",
            "minecraft:using_item",
            "minecraft:view_entity"
          ]
        },
        "entries": {
          "type": "array",
          "title": "entries 阈值分发",
          "items": {
            "$ref": "#/definitions/rangeEntry"
          }
        },
        "cases": {
          "type": "array",
          "title": "cases 条件分支",
          "items": {
            "$ref": "#/definitions/selectCase"
          }
        },
        "tints": {
          "type": "array",
          "title": "tints 着色",
          "items": {
            "$ref": "#/definitions/tint"
          }
        },
        "transformation": {
          "title": "transformation 显示变换",
          "description": "物品模型显示变换，可为 4x4 矩阵或拆分的平移、缩放、旋转对象。",
          "oneOf": [
            {
              "$ref": "#/definitions/transformationObject"
            },
            {
              "$ref": "#/definitions/matrix4"
            }
          ]
        },
        "scale": {
          "type": "number",
          "title": "scale 数值缩放",
          "description": "range_dispatch 属性值缩放。"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "title": "index 索引",
          "description": "custom_model_data 列表中的读取索引。"
        },
        "normalize": {
          "type": "boolean",
          "title": "normalize 归一化"
        },
        "wobble": {
          "type": "boolean",
          "title": "wobble 摆动"
        },
        "natural_only": {
          "type": "boolean",
          "title": "natural_only 仅自然维度"
        },
        "remaining": {
          "type": "boolean",
          "title": "remaining 剩余时长"
        },
        "period": {
          "type": "number",
          "exclusiveMinimum": 0,
          "title": "period 周期"
        },
        "component": {
          "type": "string",
          "title": "component 组件"
        },
        "target": {
          "type": "string",
          "title": "target 指南针目标",
          "enum": ["spawn", "lodestone", "recovery", "none"]
        },
        "block_state_property": {
          "type": "string",
          "title": "block_state_property 方块状态属性"
        },
        "source": {
          "type": "string",
          "title": "source 来源",
          "enum": ["daytime", "moon_phase", "random"]
        },
        "locale": {
          "type": "string",
          "title": "locale 本地化"
        },
        "time_zone": {
          "type": "string",
          "title": "time_zone 时区"
        },
        "pattern": {
          "type": "string",
          "title": "pattern 格式"
        },
        "texture": {
          "$ref": "#/definitions/resourceLocation",
          "title": "texture 纹理"
        },
        "attachment": {
          "type": "string",
          "title": "attachment 附着方式",
          "enum": ["ground", "wall", "ceiling", "ceiling_middle"]
        },
        "attachement": {
          "type": "string",
          "title": "attachement 附着方式",
          "description": "旧版 standing_sign 特殊模型中的拼写错误字段。",
          "enum": ["ground", "wall"]
        },
        "chest_type": {
          "type": "string",
          "title": "chest_type 箱子类型",
          "enum": ["single", "left", "right"]
        },
        "openness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "openness 开启程度"
        },
        "open_angle": {
          "type": "number",
          "title": "open_angle 书本打开角度"
        },
        "page1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "page1 第一页位置"
        },
        "page2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "page2 第二页位置"
        },
        "part": {
          "type": "string",
          "title": "part 部分",
          "enum": ["head", "foot"]
        },
        "effect": {
          "type": "string",
          "title": "effect 星域效果",
          "enum": ["gateway", "portal"]
        },
        "animation": {
          "type": "number",
          "title": "animation 头颅动画"
        },
        "orientation": {
          "type": "string",
          "title": "orientation 朝向",
          "enum": ["up", "down", "north", "south", "east", "west"]
        },
        "pose": {
          "type": "string",
          "title": "pose 姿势",
          "enum": ["standing", "sitting", "running", "star"]
        },
        "kind": {
          "type": "string",
          "title": "kind 头颅类型",
          "enum": ["skeleton", "wither_skeleton", "player", "zombie", "creeper", "piglin", "dragon"]
        },
        "wood_type": {
          "type": "string",
          "title": "wood_type 木质类型",
          "enum": ["oak", "spruce", "birch", "acacia", "cherry", "jungle", "dark_oak", "pale_oak", "mangrove", "bamboo", "crimson", "warped"]
        },
        "color": {
          "type": "string",
          "title": "color 颜色",
          "enum": [
            "white",
            "orange",
            "magenta",
            "light_blue",
            "yellow",
            "lime",
            "pink",
            "gray",
            "light_gray",
            "cyan",
            "purple",
            "blue",
            "brown",
            "green",
            "red",
            "black"
          ]
        }
      }
    },
    "rangeEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["threshold", "model"],
      "properties": {
        "threshold": {
          "type": "number",
          "title": "threshold 阈值"
        },
        "model": {
          "$ref": "#/definitions/itemModel",
          "title": "model 模型"
        }
      }
    },
    "selectCase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["when", "model"],
      "properties": {
        "when": {
          "title": "when 匹配值",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": ["string", "number", "boolean"]
              }
            }
          ]
        },
        "model": {
          "$ref": "#/definitions/itemModel",
          "title": "model 模型"
        }
      }
    },
    "tint": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "title": "type 着色类型",
          "enum": [
            "minecraft:constant",
            "minecraft:custom_model_data",
            "minecraft:dye",
            "minecraft:firework",
            "minecraft:grass",
            "minecraft:map_color",
            "minecraft:potion",
            "minecraft:team"
          ]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "default 默认颜色"
        },
        "value": {
          "$ref": "#/definitions/colorValue",
          "title": "value 固定颜色"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "temperature 温度"
        },
        "downfall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "downfall 降水"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "title": "index 索引"
        }
      }
    },
    "colorValue": {
      "description": "RGB 颜色，可为打包整数或三个 RGB 数值。",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      ]
    },
    "transformationObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/vector"
      },
      "properties": {
        "left_rotation": {
          "$ref": "#/definitions/quaternion",
          "title": "left_rotation 左旋转"
        },
        "right_rotation": {
          "$ref": "#/definitions/quaternion",
          "title": "right_rotation 右旋转"
        },
        "scale": {
          "$ref": "#/definitions/vector3",
          "title": "scale 缩放"
        },
        "translation": {
          "$ref": "#/definitions/vector3",
          "title": "translation 平移"
        }
      }
    },
    "matrix4": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "number"
      }
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    }
  }
}
