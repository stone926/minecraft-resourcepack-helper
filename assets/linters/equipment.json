{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/stone926/minecraft-resourcepack-helper/schemas/equipment.json",
  "type": "object",
  "title": "Minecraft equipment definition",
  "description": "定义装备渲染层所使用的纹理。",
  "additionalProperties": true,
  "required": ["layers"],
  "properties": {
    "layers": {
      "type": "object",
      "title": "layers 渲染层",
      "description": "键名为装备预设模型类型，例如 humanoid、humanoid_leggings、wings、wolf_body、llama_body。",
      "properties": {
        "humanoid": {
          "$ref": "#/definitions/layerList",
          "description": "人形生物的头部、胸部和脚部盔甲模型。"
        },
        "humanoid_leggings": {
          "$ref": "#/definitions/layerList",
          "description": "人形生物的腿部盔甲模型。"
        },
        "humanoid_baby": {
          "$ref": "#/definitions/layerList",
          "description": "幼年人形生物的盔甲模型。"
        },
        "wings": {
          "$ref": "#/definitions/layerList",
          "description": "玩家、玩家模型和盔甲架的翅膀模型。"
        },
        "wolf_body": {
          "$ref": "#/definitions/layerList",
          "description": "狼的身体盔甲模型。"
        },
        "horse_body": {
          "$ref": "#/definitions/layerList",
          "description": "马、骷髅马和僵尸马的身体盔甲模型。"
        },
        "llama_body": {
          "$ref": "#/definitions/layerList",
          "description": "羊驼和行商羊驼的身体盔甲模型。"
        },
        "happy_ghast_body": {
          "$ref": "#/definitions/layerList",
          "description": "快乐恶魂的身体盔甲模型。"
        },
        "nautilus_body": {
          "$ref": "#/definitions/layerList",
          "description": "鹦鹉螺和僵尸鹦鹉螺的身体盔甲模型。"
        },
        "pig_saddle": {
          "$ref": "#/definitions/layerList",
          "description": "猪的鞍模型。"
        },
        "strider_saddle": {
          "$ref": "#/definitions/layerList",
          "description": "炽足兽的鞍模型。"
        },
        "camel_saddle": {
          "$ref": "#/definitions/layerList",
          "description": "骆驼的鞍模型。"
        },
        "camel_husk_saddle": {
          "$ref": "#/definitions/layerList",
          "description": "骆驼尸壳的鞍模型。"
        },
        "horse_saddle": {
          "$ref": "#/definitions/layerList",
          "description": "马的鞍模型。"
        },
        "donkey_saddle": {
          "$ref": "#/definitions/layerList",
          "description": "驴的鞍模型。"
        },
        "mule_saddle": {
          "$ref": "#/definitions/layerList",
          "description": "骡的鞍模型。"
        },
        "skeleton_horse_saddle": {
          "$ref": "#/definitions/layerList",
          "description": "骷髅马的鞍模型。"
        },
        "zombie_horse_saddle": {
          "$ref": "#/definitions/layerList",
          "description": "僵尸马的鞍模型。"
        },
        "nautilus_saddle": {
          "$ref": "#/definitions/layerList",
          "description": "鹦鹉螺和僵尸鹦鹉螺的鞍模型。"
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/layerList"
      }
    }
  },
  "definitions": {
    "layerList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/layer"
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["texture"],
      "properties": {
        "texture": {
          "type": "string",
          "title": "texture 纹理",
          "description": "装备层纹理路径。插件会解析到 textures/entity/equipment/<layer>。"
        },
        "dyeable": {
          "type": "object",
          "title": "dyeable 可染色",
          "description": "可染色装备的颜色配置。",
          "additionalProperties": true,
          "properties": {
            "color_when_undyed": {
              "type": "integer",
              "title": "color_when_undyed 未染色颜色",
              "description": "未染色时使用的十进制 RGB 颜色值。"
            }
          }
        },
        "use_player_texture": {
          "type": "boolean",
          "title": "use_player_texture 使用玩家披风纹理",
          "description": "wings 预设模型层可用。为 true 时使用玩家披风纹理渲染翅膀模型，默认为 false。"
        }
      }
    }
  }
}
