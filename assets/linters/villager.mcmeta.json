{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["villager"],
  "properties": {
    "villager": {
      "type": "object",
      "additionalProperties": false,
      "description": "包含了纹理的数据",
      "properties": {
        "hat": {
          "type": "string",
          "enum": ["none", "partial", "full"],
          "description": "村民纹理帽子的渲染方式。不存在元数据时默认为 none。"
        }
      }
    }
  }
}
