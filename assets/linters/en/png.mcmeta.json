{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Minecraft PNG texture metadata",
  "description": "Metadata for PNG textures under assets/<namespace>/textures.",
  "additionalProperties": false,
  "minProperties": 1,
  "anyOf": [
    { "required": ["animation"] },
    { "required": ["texture"] },
    { "required": ["gui"] },
    { "required": ["villager"] }
  ],
  "properties": {
    "animation": {
      "type": "object",
      "title": "Animation",
      "description": "Animated texture metadata.",
      "additionalProperties": false,
      "properties": {
        "interpolate": {
          "type": "boolean",
          "description": "Whether the game should interpolate between frames."
        },
        "frametime": {
          "type": "integer",
          "minimum": 1,
          "description": "Default frame display time in game ticks."
        },
        "frames": {
          "type": "array",
          "description": "Animation frames in playback order.",
          "items": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "description": "Frame index, starting at 0."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["index"],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Frame index, starting at 0."
                  },
                  "time": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Display time for this frame in game ticks."
                  }
                }
              }
            ]
          }
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Frame width ratio."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Frame height ratio."
        }
      }
    },
    "texture": {
      "type": "object",
      "title": "Texture",
      "description": "Texture sampling metadata.",
      "additionalProperties": false,
      "properties": {
        "blur": {
          "type": "boolean",
          "description": "Whether close-up sampling should blur the texture."
        },
        "clamp": {
          "type": "boolean",
          "description": "Whether texture coordinates should clamp instead of tile."
        },
        "mipmaps": {
          "type": "array",
          "description": "Custom mipmap levels.",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "mipmap_strategy": {
          "type": "string",
          "enum": ["auto", "mean", "dark_cutout", "cutout", "strict_cutout"],
          "description": "Mipmap generation strategy. Defaults to auto."
        },
        "darkened_cutout_mipmap": {
          "type": "boolean",
          "description": "Whether cutout mipmaps should be darkened."
        },
        "alpha_cutoff_bias": {
          "type": "number",
          "description": "Bias applied to alpha cutoff during mipmap generation."
        }
      }
    },
    "gui": {
      "type": "object",
      "title": "GUI",
      "description": "GUI sprite metadata.",
      "additionalProperties": false,
      "properties": {
        "scaling": {
          "oneOf": [
            {
              "$ref": "#/definitions/stretchScaling"
            },
            {
              "$ref": "#/definitions/tileScaling"
            },
            {
              "$ref": "#/definitions/nineSliceScaling"
            }
          ],
          "title": "Scaling",
          "description": "GUI sprite scaling configuration."
        }
      }
    },
    "villager": {
      "type": "object",
      "title": "Villager",
      "description": "Villager and zombie villager texture metadata.",
      "additionalProperties": false,
      "properties": {
        "hat": {
          "type": "string",
          "enum": ["none", "partial", "full"],
          "description": "How the villager hat layer is rendered. Defaults to none."
        }
      }
    }
  },
  "definitions": {
    "scalingBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["nine_slice", "stretch", "tile"],
          "description": "Scaling strategy for this GUI sprite."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Source sprite width."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Source sprite height."
        },
        "border": {
          "description": "Nine-slice border size.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "left": {
                  "type": "integer",
                  "minimum": 0
                },
                "top": {
                  "type": "integer",
                  "minimum": 0
                },
                "right": {
                  "type": "integer",
                  "minimum": 0
                },
                "bottom": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "stretch_inner": {
          "type": "boolean",
          "description": "Whether the center area of a nine-slice sprite stretches."
        }
      }
    },
    "stretchScaling": {
      "allOf": [
        { "$ref": "#/definitions/scalingBase" },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "stretch"
            }
          }
        }
      ]
    },
    "tileScaling": {
      "allOf": [
        { "$ref": "#/definitions/scalingBase" },
        {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "type": {
              "const": "tile"
            }
          }
        }
      ]
    },
    "nineSliceScaling": {
      "allOf": [
        { "$ref": "#/definitions/scalingBase" },
        {
          "type": "object",
          "required": ["width", "height", "border"],
          "properties": {
            "type": {
              "const": "nine_slice"
            }
          }
        }
      ]
    }
  }
}