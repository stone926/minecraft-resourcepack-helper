{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Minecraft item model definition",
  "description": "New-style item model selection definitions in the items directory.",
  "additionalProperties": true,
  "required": ["model"],
  "properties": {
    "model": {
      "$ref": "#/definitions/itemModel",
      "title": "Item model"
    },
    "hand_animation_on_swap": {
      "type": "boolean",
      "title": "Swap animation",
      "description": "Whether the first-person downward animation plays when swapping inventory slots or moving to the other hand. Defaults to true."
    },
    "oversized_in_gui": {
      "type": "boolean",
      "title": "Oversized in GUI",
      "description": "Whether the item model is allowed to render beyond the item slot in GUIs. Defaults to false."
    },
    "swap_animation_scale": {
      "type": "number",
      "title": "Swap animation scale"
    }
  },
  "definitions": {
    "resourceLocation": {
      "type": "string",
      "description": "Minecraft resource path, e.g. minecraft:item/diamond_sword."
    },
    "topLevelType": {
      "type": "string",
      "enum": [
        "minecraft:model",
        "minecraft:composite",
        "minecraft:condition",
        "minecraft:select",
        "minecraft:range_dispatch",
        "minecraft:empty",
        "minecraft:bundle/selected_item",
        "minecraft:special",
        "model",
        "composite",
        "condition",
        "select",
        "range_dispatch",
        "empty",
        "bundle/selected_item",
        "special"
      ]
    },
    "itemModel": {
      "oneOf": [
        { "$ref": "#/definitions/modelItemModel" },
        { "$ref": "#/definitions/compositeItemModel" },
        { "$ref": "#/definitions/conditionItemModel" },
        { "$ref": "#/definitions/selectItemModel" },
        { "$ref": "#/definitions/rangeDispatchItemModel" },
        { "$ref": "#/definitions/specialItemModel" },
        { "$ref": "#/definitions/selectedItemModel" },
        { "$ref": "#/definitions/emptyItemModel" }
      ]
    },
    "transformableItemModel": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "transformation": {
          "$ref": "#/definitions/transformation",
          "title": "Display transformation",
          "description": "Item model display transformation. Can be a 4x4 matrix or a decomposed translation, scale, rotation object."
        }
      }
    },
    "modelItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "model"],
          "properties": {
            "type": {
              "type": "string",
              "title": "Plain model type",
              "enum": ["minecraft:model", "model"]
            },
            "model": {
              "$ref": "#/definitions/resourceLocation",
              "title": "Model"
            },
            "tints": {
              "type": "array",
              "title": "Tints",
              "items": {
                "$ref": "#/definitions/tint"
              }
            }
          }
        }
      ]
    },
    "compositeItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "models"],
          "properties": {
            "type": {
              "type": "string",
              "title": "Composite model type",
              "enum": ["minecraft:composite", "composite"]
            },
            "models": {
              "type": "array",
              "title": "Composition models",
              "items": {
                "$ref": "#/definitions/itemModel"
              }
            }
          }
        }
      ]
    },
    "conditionItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "property", "on_true", "on_false"],
          "allOf": [
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:component", "component"] }
                }
              },
              "then": { "required": ["predicate", "value"] }
            },
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:has_component", "has_component"] }
                }
              },
              "then": { "required": ["component"] }
            },
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:keybind_down", "keybind_down"] }
                }
              },
              "then": { "required": ["keybind"] }
            }
          ],
          "properties": {
            "type": {
              "type": "string",
              "title": "Condition model type",
              "enum": ["minecraft:condition", "condition"]
            },
            "property": {
              "$ref": "#/definitions/conditionPropertyType",
              "title": "Boolean property"
            },
            "component": {
              "type": "string",
              "title": "Component"
            },
            "ignore_default": {
              "type": "boolean",
              "title": "Ignore default component"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "title": "Index"
            },
            "keybind": {
              "type": "string",
              "title": "Keybind"
            },
            "predicate": {
              "type": "string",
              "title": "Predicate",
              "description": "Type of data component predicate (for minecraft:component property)."
            },
            "value": {
              "title": "Value",
              "description": "Value to match against the predicate (for minecraft:component property)."
            },
            "on_true": {
              "$ref": "#/definitions/itemModel",
              "title": "On true"
            },
            "on_false": {
              "$ref": "#/definitions/itemModel",
              "title": "On false"
            }
          }
        }
      ]
    },
    "selectItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "property", "cases"],
          "allOf": [
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:block_state", "block_state"] }
                }
              },
              "then": { "required": ["block_state_property"] }
            },
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:component", "component"] }
                }
              },
              "then": { "required": ["component"] }
            },
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:local_time", "local_time"] }
                }
              },
              "then": { "required": ["pattern"] }
            }
          ],
          "properties": {
            "type": {
              "type": "string",
              "title": "Select model type",
              "enum": ["minecraft:select", "select"]
            },
            "property": {
              "$ref": "#/definitions/selectPropertyType",
              "title": "Select property"
            },
            "component": {
              "type": "string",
              "title": "Component"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "title": "Index"
            },
            "block_state_property": {
              "type": "string",
              "title": "Block state property"
            },
            "locale": {
              "type": "string",
              "title": "Locale"
            },
            "time_zone": {
              "type": "string",
              "title": "Time zone"
            },
            "pattern": {
              "type": "string",
              "title": "Pattern"
            },
            "cases": {
              "type": "array",
              "title": "Cases",
              "items": {
                "$ref": "#/definitions/selectCase"
              }
            },
            "fallback": {
              "$ref": "#/definitions/itemModel",
              "title": "Fallback model"
            }
          }
        }
      ]
    },
    "rangeDispatchItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "property", "entries"],
          "allOf": [
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:compass", "compass"] }
                }
              },
              "then": { "required": ["target"] }
            },
            {
              "if": {
                "properties": {
                  "property": { "enum": ["minecraft:time", "time"] }
                }
              },
              "then": { "required": ["source"] }
            }
          ],
          "properties": {
            "type": {
              "type": "string",
              "title": "Range dispatch model type",
              "enum": ["minecraft:range_dispatch", "range_dispatch"]
            },
            "property": {
              "$ref": "#/definitions/rangeDispatchPropertyType",
              "title": "Range property"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "title": "Index"
            },
            "normalize": {
              "type": "boolean",
              "title": "Normalize"
            },
            "wobble": {
              "type": "boolean",
              "title": "Wobble"
            },
            "remaining": {
              "type": "boolean",
              "title": "Remaining"
            },
            "period": {
              "type": "number",
              "exclusiveMinimum": 0,
              "title": "Period"
            },
            "target": {
              "type": "string",
              "title": "Compass target",
              "enum": ["spawn", "lodestone", "recovery", "none"]
            },
            "source": {
              "type": "string",
              "title": "Source",
              "enum": ["daytime", "moon_phase", "random"]
            },
            "entries": {
              "type": "array",
              "title": "Threshold entries",
              "items": {
                "$ref": "#/definitions/rangeEntry"
              }
            },
            "fallback": {
              "$ref": "#/definitions/itemModel",
              "title": "Fallback model"
            },
            "scale": {
              "type": "number",
              "title": "Value scale",
              "description": "Scale for the range_dispatch property value."
            }
          }
        }
      ]
    },
    "specialItemModel": {
      "allOf": [
        { "$ref": "#/definitions/transformableItemModel" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "base", "model"],
          "properties": {
            "type": {
              "type": "string",
              "title": "Special model type",
              "enum": ["minecraft:special", "special"]
            },
            "base": {
              "$ref": "#/definitions/resourceLocation",
              "title": "Base model",
              "description": "The base item model used by the special model. Resolves to assets/<namespace>/models/<path>.json."
            },
            "model": {
              "$ref": "#/definitions/specialModel",
              "title": "Special model configuration"
            }
          }
        }
      ]
    },
    "selectedItemModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Selected item type",
          "enum": ["minecraft:bundle/selected_item", "bundle/selected_item"]
        }
      }
    },
    "emptyItemModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Empty model type",
          "enum": ["minecraft:empty", "empty"]
        }
      }
    },
    "conditionPropertyType": {
      "type": "string",
      "enum": [
        "minecraft:broken",
        "minecraft:bundle/has_selected_item",
        "minecraft:carried",
        "minecraft:component",
        "minecraft:custom_model_data",
        "minecraft:damaged",
        "minecraft:extended_view",
        "minecraft:fishing_rod/cast",
        "minecraft:has_component",
        "minecraft:keybind_down",
        "minecraft:selected",
        "minecraft:using_item",
        "minecraft:view_entity",
        "broken",
        "bundle/has_selected_item",
        "carried",
        "component",
        "custom_model_data",
        "damaged",
        "extended_view",
        "fishing_rod/cast",
        "has_component",
        "keybind_down",
        "selected",
        "using_item",
        "view_entity"
      ]
    },
    "selectPropertyType": {
      "type": "string",
      "enum": [
        "minecraft:block_state",
        "minecraft:charge_type",
        "minecraft:component",
        "minecraft:context_dimension",
        "minecraft:context_entity_type",
        "minecraft:custom_model_data",
        "minecraft:display_context",
        "minecraft:local_time",
        "minecraft:main_hand",
        "minecraft:trim_material",
        "block_state",
        "charge_type",
        "component",
        "context_dimension",
        "context_entity_type",
        "custom_model_data",
        "display_context",
        "local_time",
        "main_hand",
        "trim_material"
      ]
    },
    "rangeDispatchPropertyType": {
      "type": "string",
      "enum": [
        "minecraft:bundle/fullness",
        "minecraft:compass",
        "minecraft:cooldown",
        "minecraft:count",
        "minecraft:crossbow/pull",
        "minecraft:custom_model_data",
        "minecraft:damage",
        "minecraft:time",
        "minecraft:use_cycle",
        "minecraft:use_duration",
        "bundle/fullness",
        "compass",
        "cooldown",
        "count",
        "crossbow/pull",
        "custom_model_data",
        "damage",
        "time",
        "use_cycle",
        "use_duration"
      ]
    },
    "rangeEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["threshold", "model"],
      "properties": {
        "threshold": {
          "type": "number",
          "title": "Threshold"
        },
        "model": {
          "$ref": "#/definitions/itemModel",
          "title": "Model"
        }
      }
    },
    "selectCase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["when", "model"],
      "properties": {
        "when": {
          "title": "When"
        },
        "model": {
          "$ref": "#/definitions/itemModel",
          "title": "Model"
        }
      }
    },
    "tint": {
      "oneOf": [
        { "$ref": "#/definitions/constantTint" },
        { "$ref": "#/definitions/dyeTint" },
        { "$ref": "#/definitions/fireworkTint" },
        { "$ref": "#/definitions/grassTint" },
        { "$ref": "#/definitions/mapColorTint" },
        { "$ref": "#/definitions/potionTint" },
        { "$ref": "#/definitions/teamTint" },
        { "$ref": "#/definitions/customModelDataTint" }
      ]
    },
    "constantTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Tint type",
          "enum": ["minecraft:constant", "constant"]
        },
        "value": {
          "$ref": "#/definitions/colorValue",
          "title": "Fixed color"
        }
      }
    },
    "dyeTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Tint type",
          "enum": ["minecraft:dye", "dye"]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "Default color"
        }
      }
    },
    "fireworkTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Tint type",
          "enum": ["minecraft:firework", "firework"]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "Default color"
        }
      }
    },
    "grassTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "temperature", "downfall"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Tint type",
          "enum": ["minecraft:grass", "grass"]
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "Temperature"
        },
        "downfall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "Downfall"
        }
      }
    },
    "mapColorTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Tint type",
          "enum": ["minecraft:map_color", "map_color"]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "Default color"
        }
      }
    },
    "potionTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Tint type",
          "enum": ["minecraft:potion", "potion"]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "Default color"
        }
      }
    },
    "teamTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Tint type",
          "enum": ["minecraft:team", "team"]
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "Default color"
        }
      }
    },
    "customModelDataTint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Tint type",
          "enum": ["minecraft:custom_model_data", "custom_model_data"]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "title": "Index"
        },
        "default": {
          "$ref": "#/definitions/colorValue",
          "title": "Default color"
        }
      }
    },
    "specialModel": {
      "oneOf": [
        { "$ref": "#/definitions/bannerSpecialModel" },
        { "$ref": "#/definitions/bellSpecialModel" },
        { "$ref": "#/definitions/bookSpecialModel" },
        { "$ref": "#/definitions/chestSpecialModel" },
        { "$ref": "#/definitions/conduitSpecialModel" },
        { "$ref": "#/definitions/copperGolemStatueSpecialModel" },
        { "$ref": "#/definitions/decoratedPotSpecialModel" },
        { "$ref": "#/definitions/endCubeSpecialModel" },
        { "$ref": "#/definitions/headSpecialModel" },
        { "$ref": "#/definitions/playerHeadSpecialModel" },
        { "$ref": "#/definitions/shieldSpecialModel" },
        { "$ref": "#/definitions/shulkerBoxSpecialModel" },
        { "$ref": "#/definitions/tridentSpecialModel" }
      ]
    },
    "specialModelType": {
      "type": "string",
      "enum": [
        "minecraft:banner",
        "minecraft:bell",
        "minecraft:book",
        "minecraft:chest",
        "minecraft:conduit",
        "minecraft:copper_golem_statue",
        "minecraft:decorated_pot",
        "minecraft:end_cube",
        "minecraft:head",
        "minecraft:player_head",
        "minecraft:shield",
        "minecraft:shulker_box",
        "minecraft:trident",
        "banner",
        "bell",
        "book",
        "chest",
        "conduit",
        "copper_golem_statue",
        "decorated_pot",
        "end_cube",
        "head",
        "player_head",
        "shield",
        "shulker_box",
        "trident"
      ]
    },
    "bannerSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "color"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:banner", "banner"]
        },
        "attachment": {
          "type": "string",
          "title": "Attachment",
          "enum": ["ground", "wall"]
        },
        "color": {
          "$ref": "#/definitions/dyeColor",
          "title": "Color"
        }
      }
    },
    "bellSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:bell", "bell"]
        }
      }
    },
    "bookSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "open_angle", "page1", "page2"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:book", "book"]
        },
        "open_angle": {
          "type": "integer",
          "title": "Book open angle"
        },
        "page1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "First page position"
        },
        "page2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "Second page position"
        }
      }
    },
    "chestSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "texture"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:chest", "chest"]
        },
        "texture": {
          "$ref": "#/definitions/resourceLocation",
          "title": "Chest texture",
          "description": "Resolves to textures/entity/chest/<path>.png."
        },
        "chest_type": {
          "type": "string",
          "title": "Chest type",
          "enum": ["single", "left", "right"]
        },
        "openness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "Openness"
        }
      }
    },
    "conduitSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:conduit", "conduit"]
        }
      }
    },
    "copperGolemStatueSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "pose", "texture"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:copper_golem_statue", "copper_golem_statue"]
        },
        "pose": {
          "type": "string",
          "title": "Pose",
          "enum": ["standing", "sitting", "running", "star"]
        },
        "texture": {
          "$ref": "#/definitions/resourceLocation",
          "title": "Copper Golem Statue texture",
          "description": "Resolves to assets/<namespace>/<path>."
        }
      }
    },
    "decoratedPotSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:decorated_pot", "decorated_pot"]
        }
      }
    },
    "endCubeSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "effect"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:end_cube", "end_cube"]
        },
        "effect": {
          "type": "string",
          "title": "End effect",
          "enum": ["gateway", "portal"]
        }
      }
    },
    "headSpecialModel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "kind"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minecraft:head", "head"]
        },
        "kind": {
          "type": "string",
          "title": "Head kind",
          "enum": ["skeleton", "wither_skeleton", "player", "zombie", "creeper", "piglin", "dragon"]
        },
        "texture": {
          "$ref": "#/definitions/resourceLocation",
          "title": "Head texture"
        },
        "animation": {
          "type": "number",
          "title": "Head animation"
        }
      }
    },
    "playerHeadSpecialModel": {
      "type": "object",
