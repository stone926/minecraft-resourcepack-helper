{
  "name": "minecraft-resourcepack-helper",
  "private": true,
  "displayName": "%extension.displayName%",
  "publisher": "stone926",
  "author": {
    "name": "stone926"
  },
  "contributors": [
    "stone926",
    "hans000"
  ],
  "description": "%extension.description%",
  "version": "2.3.3",
  "license": "Unlicense",
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "icon.png",
  "categories": [
    "Linters",
    "Other"
  ],
  "repository": {
    "url": "https://github.com/stone926/minecraft-resourcepack-helper",
    "type": "git"
  },
  "activationEvents": [
    "workspaceContains:**/pack.mcmeta"
  ],
  "keywords": [
    "minecraft",
    "resourcepack",
    "resource pack",
    "helper",
    "assets helper",
    "mc"
  ],
  "main": "./bundle/extension.js",
  "extensionPack": [
    "stone926.rsgl"
  ],
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".mcmeta"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/pack.mcmeta",
        "url": "%schema.packMcmeta.url%"
      },
      {
        "fileMatch": "**/blockstates/*.json",
        "url": "%schema.blockstates.url%"
      },
      {
        "fileMatch": "**/models/**/*.json",
        "url": "%schema.modelsBlock.url%"
      },
      {
        "fileMatch": "**/models/item/**/*.json",
        "url": "%schema.modelsItem.url%"
      },
      {
        "fileMatch": "**/particles/**/*.json",
        "url": "%schema.particles.url%"
      },
      {
        "fileMatch": "**/items/**/*.json",
        "url": "%schema.items.url%"
      },
      {
        "fileMatch": "**/atlases/**/*.json",
        "url": "%schema.atlases.url%"
      },
      {
        "fileMatch": "**/equipment/**/*.json",
        "url": "%schema.equipment.url%"
      },
      {
        "fileMatch": "**/font/**/*.json",
        "url": "%schema.font.url%"
      },
      {
        "fileMatch": "**/waypoint_style/**/*.json",
        "url": "%schema.waypointStyle.url%"
      },
      {
        "fileMatch": "**/post_effect/**/*.json",
        "url": "%schema.postEffect.url%"
      },
      {
        "fileMatch": "**/assets/*/sounds.json",
        "url": "%schema.sounds.url%"
      },
      {
        "fileMatch": "**/assets/*/lang/*.json",
        "url": "%schema.lang.url%"
      },
      {
        "fileMatch": "**/assets/*/texts/credits.json",
        "url": "%schema.credits.url%"
      },
      {
        "fileMatch": "**/assets/*/gpu_warnlist.json",
        "url": "%schema.gpuWarnlist.url%"
      },
      {
        "fileMatch": "**/assets/*/regional_compliancies.json",
        "url": "%schema.regionalCompliancies.url%"
      },
      {
        "fileMatch": "**/textures/**/*.png.mcmeta",
        "url": "%schema.pngMcmeta.url%"
      }
    ],
    "commands": [
      {
        "command": "McResHelper.openDefaultMcAssetsPath",
        "title": "%command.title.openDefaultMcAssetsPath%"
      },
      {
        "command": "McResHelper.createNewResourcePack",
        "title": "%command.title.createNewResourcePack%"
      },
      {
        "command": "McResHelper.createNewResourcePackRoot",
        "title": "%command.title.createNewResourcePackRoot%"
      },
      {
        "command": "McResHelper.refreshResourceGraph",
        "title": "%command.title.refreshResourceGraph%",
        "icon": "$(refresh)"
      },
      {
        "command": "McResHelper.refreshResources",
        "title": "%command.title.refreshResources%",
        "icon": "$(sync)"
      },
      {
        "command": "McResHelper.openModelPreview",
        "title": "%command.title.openModelPreview%",
        "icon": "$(preview)"
      },
      {
        "command": "McResHelper.exportModelPreviewImage",
        "title": "%command.title.exportModelPreviewImage%",
        "icon": "$(save-as)"
      },
      {
        "command": "McResHelper.openResourceGraphModelPreview",
        "title": "%command.title.openResourceGraphModelPreview%",
        "icon": "$(preview)"
      },
      {
        "command": "McResHelper.openUnsupportedModelPreviewResource",
        "title": "%command.title.openUnsupportedModelPreviewResource%",
        "icon": "$(circle-slash)"
      },
      {
        "command": "McResHelper.createCitTemplate",
        "title": "%command.title.createCitTemplate%",
        "icon": "$(new-file)"
      },
      {
        "command": "McResHelper.generateCitForCurrentItem",
        "title": "%command.title.generateCitForCurrentItem%",
        "icon": "$(wand)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcResHelperResources",
          "title": "%viewContainer.title.resources%",
          "icon": "assets/mcResHelperSidebar.svg"
        }
      ]
    },
    "views": {
      "mcResHelperResources": [
        {
          "id": "McResHelper.resourceGraph",
          "name": "%view.name.resourceGraph%"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "McResHelper.openModelPreview",
          "when": "resourceLangId == json && resourceExtname == .json && resourceDirname =~ /[\\\\/]assets[\\\\/][^\\\\/]+[\\\\/]models(?:[\\\\/]|$)/",
          "group": "navigation"
        },
        {
          "command": "McResHelper.openModelPreview",
          "when": "resourceExtname == .properties && resourceDirname =~ /[\\\\/]assets[\\\\/][^\\\\/]+[\\\\/]citresewn(?:[\\\\/]|$)/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "McResHelper.openModelPreview",
          "when": "resourceLangId == json && resourceExtname == .json && resourceDirname =~ /[\\\\/]assets[\\\\/][^\\\\/]+[\\\\/]models(?:[\\\\/]|$)/",
          "group": "navigation"
        },
        {
          "command": "McResHelper.openModelPreview",
          "when": "resourceExtname == .properties && resourceDirname =~ /[\\\\/]assets[\\\\/][^\\\\/]+[\\\\/]citresewn(?:[\\\\/]|$)/",
          "group": "navigation"
        },
        {
          "command": "McResHelper.exportModelPreviewImage",
          "when": "resourceLangId == json && resourceExtname == .json && resourceDirname =~ /[\\\\/]assets[\\\\/][^\\\\/]+[\\\\/]models(?:[\\\\/]|$)/",
          "group": "navigation"
        },
        {
          "command": "McResHelper.generateCitForCurrentItem",
          "when": "resourceExtname =~ /\\.(json|png)$/ && resourceDirname =~ /[\\\\/]assets[\\\\/][^\\\\/]+[\\\\/](?:items|models[\\\\/]item|textures[\\\\/]item)(?:[\\\\/]|$)/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "McResHelper.refreshResourceGraph",
          "when": "view == McResHelper.resourceGraph",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "McResHelper.openResourceGraphModelPreview",
          "when": "view == McResHelper.resourceGraph && viewItem == modelResource",
          "group": "inline"
        },
        {
          "command": "McResHelper.openResourceGraphModelPreview",
          "when": "view == McResHelper.resourceGraph && viewItem == citPreviewResource",
          "group": "inline"
        },
        {
          "command": "McResHelper.openUnsupportedModelPreviewResource",
          "when": "view == McResHelper.resourceGraph && viewItem == unsupportedPreviewResource",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "McResHelper.defaultMcAssetsPath": {
          "type": "string",
          "description": "%config.desc.defaultMcAssetsPath%",
          "default": ""
        },
        "McResHelper.resourcePackLoadOrder": {
          "type": "array",
          "description": "%config.desc.resourcePackLoadOrder%",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "McResHelper.tipColorForUndefinedTextureVariables": {
          "type": "string",
          "description": "%config.desc.tipColorForUndefinedTextureVariables%",
          "default": "Chartreuse"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/build.mjs main",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs all",
    "build:main": "node scripts/build.mjs main",
    "build:rsgl": "node scripts/build.mjs rsgl",
    "build:rsgl-cli": "node scripts/build.mjs rsgl-cli",
    "build:test": "node scripts/build.mjs test",
    "watch": "tsc -b tsconfig.tests.json --watch",
    "watch:rsgl-extension": "tsc -b extensions/vscode-rsgl/tsconfig.json --watch",
    "pretest": "node scripts/build.mjs test && eslint \"src/**/*.ts\" \"packages/**/*.ts\" \"extensions/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"packages/**/*.ts\" \"extensions/**/*.ts\" \"test/**/*.ts\"",
    "test": "mocha \"./out/src/test/unit/**/*.test.js\" \"./out/packages/**/test/**/*.test.js\" \"./out/extensions/**/test/**/*.test.js\" \"./out/test/**/*.test.js\"",
    "test:rsgl:better-textures": "node scripts/build.mjs all --typecheck-only && node scripts/verify-rsgl-better-textures.mjs",
    "benchmark:model-preview": "node scripts/build.mjs all --typecheck-only && node scripts/model-preview-benchmark.mjs",
    "benchmark:rsgl": "node scripts/build.mjs all --typecheck-only && node scripts/rsgl-benchmark.mjs",
    "verify:build-budgets": "node scripts/build.mjs all --bundle-only && node scripts/verify-build-budgets.mjs --target all",
    "package:main:vsix": "node scripts/artifact.mjs package main",
    "verify:main:vsix": "node scripts/artifact.mjs verify main",
    "package:rsgl:vsix": "node scripts/artifact.mjs package rsgl",
    "verify:rsgl:vsix": "node scripts/artifact.mjs verify rsgl",
    "package:rsgl-cli": "node scripts/artifact.mjs package rsgl-cli",
    "verify:rsgl-cli": "node scripts/artifact.mjs verify rsgl-cli",
    "release:main": "node scripts/release.mjs main",
    "release:rsgl": "node scripts/release.mjs rsgl",
    "release:rsgl:current": "node scripts/release.mjs rsgl current",
    "release:rsgl-cli": "node scripts/release.mjs rsgl-cli",
    "release:rsgl-cli:current": "node scripts/release.mjs rsgl-cli current"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "mocha": "^11.7.6",
    "three": "^0.185.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "dependencies": {
    "@humanwhocodes/momoa": "^3.3.10"
  }
}
