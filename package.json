{
  "name": "minecraft-resourcepack-helper",
  "displayName": "Minecraft Resourcepack Helper",
  "publisher": "stone926",
  "author": {
    "name": "stone926"
  },
  "contributors": [
    "stone926",
    "hans000"
  ],
  "description": "To help minecraft developers create resource packs more efficiently",
  "version": "1.3.3",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "icon.png",
  "categories": [
    "Linters",
    "Other"
  ],
  "repository": {
    "url": "https://github.com/stone926/minecraft-resourcepack-helper",
    "type": "git"
  },
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:properties",
    "workspaceContains:**/pack.mcmeta",
    "onCommand:McResHelper.openDefaultMcAssetsPath",
    "onCommand:McResHelper.createNewResourcePack",
    "onCommand:McResHelper.createNewResourcePackRoot",
    "onCommand:McResHelper.refreshResourceGraph",
    "onView:McResHelper.resourceGraph"
  ],
  "keywords": [
    "minecraft",
    "resourcepack",
    "resource pack",
    "helper",
    "assets helper",
    "mc"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".mcmeta"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/pack.mcmeta",
        "url": "./assets/linters/pack.mcmeta.json"
      },
      {
        "fileMatch": "**/blockstates/*.json",
        "url": "./assets/linters/blockstates.json"
      },
      {
        "fileMatch": "**/models/block/**/*.json",
        "url": "./assets/linters/models-block.json"
      },
      {
        "fileMatch": "**/models/item/**/*.json",
        "url": "./assets/linters/models-item.json"
      },
      {
        "fileMatch": "**/particles/**/*.json",
        "url": "./assets/linters/particles.json"
      },
      {
        "fileMatch": "**/items/**/*.json",
        "url": "./assets/linters/items.json"
      },
      {
        "fileMatch": "**/atlases/**/*.json",
        "url": "./assets/linters/atlases.json"
      },
      {
        "fileMatch": "**/equipment/**/*.json",
        "url": "./assets/linters/equipment.json"
      },
      {
        "fileMatch": "**/font/**/*.json",
        "url": "./assets/linters/font.json"
      },
      {
        "fileMatch": "**/waypoint_style/**/*.json",
        "url": "./assets/linters/waypoint-style.json"
      },
      {
        "fileMatch": "**/post_effect/**/*.json",
        "url": "./assets/linters/post-effect.json"
      },
      {
        "fileMatch": "**/assets/*/sounds.json",
        "url": "./assets/linters/sounds.json"
      },
      {
        "fileMatch": "**/assets/*/lang/*.json",
        "url": "./assets/linters/lang.json"
      },
      {
        "fileMatch": "**/assets/*/texts/credits.json",
        "url": "./assets/linters/credits.json"
      },
      {
        "fileMatch": "**/assets/*/gpu_warnlist.json",
        "url": "./assets/linters/gpu-warnlist.json"
      },
      {
        "fileMatch": "**/assets/*/regional_compliancies.json",
        "url": "./assets/linters/regional-compliancies.json"
      },
      {
        "fileMatch": "**/textures/**/*.png.mcmeta",
        "url": "./assets/linters/png.mcmeta.json"
      }
    ],
    "commands": [
      {
        "command": "McResHelper.openDefaultMcAssetsPath",
        "title": "%command.title.openDefaultMcAssetsPath%"
      },
      {
        "command": "McResHelper.createNewResourcePack",
        "title": "%command.title.createNewResourcePack%"
      },
      {
        "command": "McResHelper.createNewResourcePackRoot",
        "title": "%command.title.createNewResourcePackRoot%"
      },
      {
        "command": "McResHelper.refreshResourceGraph",
        "title": "%command.title.refreshResourceGraph%",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "McResHelper.resourceGraph",
          "name": "%view.name.resourceGraph%"
        }
      ]
    },
    "configuration": {
      "title": "Minecraft Resourcepack Helper",
      "properties": {
        "McResHelper.defaultMcAssetsPath": {
          "type": "string",
          "description": "%config.desc.defaultMcAssetsPath%",
          "default": ""
        },
        "McResHelper.tipColorForUndefinedTextureVariables": {
          "type": "string",
          "description": "%config.desc.tipColorForUndefinedTextureVariables%",
          "default": "Chartreuse"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "mocha \"./out/test/unit/**/*.test.js\"",
    "push": "git push origin master && git push github master"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "@humanwhocodes/momoa": "^3.3.10"
  }
}
