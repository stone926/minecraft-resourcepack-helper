{
  "name": "rsgl",
  "private": true,
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "stone926",
  "version": "2.3.1",
  "license": "Unlicense",
  "repository": {
    "url": "https://github.com/stone926/minecraft-resourcepack-helper",
    "type": "git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "minecraft",
    "resource pack",
    "rsgl",
    "language",
    "generator"
  ],
  "activationEvents": [
    "onLanguage:rsgl",
    "onCommand:rsgl.build",
    "onCommand:rsgl.previewBuild",
    "onCommand:rsgl.buildDirectory",
    "onCommand:rsgl.previewDirectoryBuild",
    "onCommand:rsgl.buildWorkspace",
    "onCommand:rsgl.previewWorkspaceBuild"
  ],
  "main": "./out/extensions/vscode-rsgl/src/extension.js",
  "l10n": "./l10n",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "precompile": "node ../../scripts/clean.mjs extensions/vscode-rsgl/out",
    "compile": "tsc -p ./tsconfig.json",
    "postcompile": "node ../../scripts/copy-rsgl-stdlib.mjs extensions/vscode-rsgl/out",
    "watch": "tsc -watch -p ./tsconfig.json"
  },
  "contributes": {
    "languages": [
      {
        "id": "rsgl",
        "aliases": [
          "RSGL",
          "rsgl"
        ],
        "extensions": [
          ".rsgl"
        ],
        "configuration": "./language-configuration/rsgl.json"
      }
    ],
    "grammars": [
      {
        "language": "rsgl",
        "scopeName": "source.rsgl",
        "path": "./syntaxes/rsgl.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/rsgl.config.json",
        "url": "./schemas/rsgl-config.schema.json"
      }
    ],
    "commands": [
      {
        "command": "rsgl.build",
        "title": "%command.title.build%",
        "icon": "$(play)"
      },
      {
        "command": "rsgl.previewBuild",
        "title": "%command.title.previewBuild%",
        "icon": "$(diff)"
      },
      {
        "command": "rsgl.buildDirectory",
        "title": "%command.title.buildDirectory%",
        "icon": "$(run-all)"
      },
      {
        "command": "rsgl.previewDirectoryBuild",
        "title": "%command.title.previewDirectoryBuild%",
        "icon": "$(diff)"
      },
      {
        "command": "rsgl.buildWorkspace",
        "title": "%command.title.buildWorkspace%",
        "icon": "$(run-all)"
      },
      {
        "command": "rsgl.previewWorkspaceBuild",
        "title": "%command.title.previewWorkspaceBuild%",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rsgl.build",
          "when": "resourceLangId == rsgl",
          "group": "navigation"
        },
        {
          "command": "rsgl.previewBuild",
          "when": "resourceLangId == rsgl",
          "group": "navigation@1"
        },
        {
          "command": "rsgl.buildDirectory",
          "when": "resourceLangId == rsgl",
          "group": "navigation@2"
        },
        {
          "command": "rsgl.previewDirectoryBuild",
          "when": "resourceLangId == rsgl",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "rsgl.build",
          "when": "resourceLangId == rsgl",
          "group": "navigation"
        },
        {
          "command": "rsgl.previewBuild",
          "when": "resourceLangId == rsgl",
          "group": "navigation@1"
        },
        {
          "command": "rsgl.buildDirectory",
          "when": "resourceLangId == rsgl",
          "group": "navigation@2"
        },
        {
          "command": "rsgl.previewDirectoryBuild",
          "when": "resourceLangId == rsgl",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "rsgl.outDir": {
          "type": "string",
          "default": "",
          "description": "%config.desc.outDir%"
        },
        "rsgl.defaultAssetsPath": {
          "type": "string",
          "default": "",
          "description": "%config.desc.defaultAssetsPath%"
        },
        "rsgl.resourcePackLoadOrder": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%config.desc.resourcePackLoadOrder%"
        }
      }
    }
  },
  "dependencies": {
    "@humanwhocodes/momoa": "^3.3.10",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.125.0",
    "typescript": "^6.0.3"
  }
}
