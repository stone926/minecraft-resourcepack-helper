{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "composite": true,
    "incremental": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ]
  }
}
