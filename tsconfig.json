{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": ".",
		"strict": true,
		"moduleResolution": "Node16",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [
			"node",
			"vscode",
			"mocha"
		]
  },
	"include": [
		"src/**/*.ts",
		"packages/**/*.ts",
		"extensions/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"out",
		"packages/**/out",
		"extensions/**/out",
		".vscode-test"
	]
}
