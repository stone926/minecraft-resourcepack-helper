// A launch configuration that compiles the extension and then opens it inside a new window.
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extensions",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--extensionDevelopmentPath=${workspaceFolder}/extensions/vscode-rsgl"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js",
				"${workspaceFolder}/extensions/vscode-rsgl/out/**/*.js"
			],
			"preLaunchTask": "npm: compile:all"
		},
		{
			"name": "Debug Unit Tests",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": [
				"${workspaceFolder}/out/src/test/unit/**/*.test.js",
				"${workspaceFolder}/out/packages/**/test/**/*.test.js"
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"preLaunchTask": "npm: compile:test",
			"skipFiles": [
				"<node_internals>/**"
			]
		}
	]
}
